def log_once(msg: str, level: int = logging.INFO) -> None:
    if msg not in logged_msgs:
        logging.log(level, msg)
        logged_msgs.add(msg)  # type: ignore


def is_metered_connection() -> bool | None:
    """Return whether the active network connection is metered.

    Returns True/False, or None when it cannot be determined (python3-gi
    missing or NetworkManager not reachable on the system bus).

    Queries NetworkManager's "Metered" D-Bus property directly rather than via
    Gio.NetworkMonitor.get_default(), which on hosts without NetworkManager
    dumps the entire kernel route table -- prohibitively expensive on machines
    carrying a full BGP table (LP: #2157046, GH: #404).
    """
    try:
        from gi.repository import Gio, GLib
    except ImportError:
        log_once(_("Checking if connection is metered is skipped. Please "
                   "install python3-gi package to detect metered "
                   "connections and skip downloading updates."))
        return None
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        ret = bus.call_sync(
            "org.freedesktop.NetworkManager",
            "/org/freedesktop/NetworkManager",
            "org.freedesktop.DBus.Properties",
            "Get",
            GLib.Variant("(ss)",
                         ("org.freedesktop.NetworkManager", "Metered")),
            GLib.VariantType("(v)"),
            Gio.DBusCallFlags.NO_AUTO_START,
            METERED_DBUS_TIMEOUT_MSEC,
            None)
    except GLib.Error as e:
        log_once(_("Checking if connection is metered is skipped because "
                   "NetworkManager could not be queried: %s") % str(e))
        return None
    # NMMetered enum: 1 = YES, 3 = GUESS_YES are metered
    return ret.unpack()[0] in (1, 3)


def read_power_supply_attr(supply: str, attr: str) -> str | None:
    try:
        with open(os.path.join(supply, attr)) as f:
            return f.read().strip()
    except OSError:
        return None


def get_battery_level() -> int | None:
    """
    Return the average charge in percent of the system batteries, or None
    if any of them can not be read.
    """
    levels: list[int] = []
    for supply in glob.glob(os.path.join(POWER_SUPPLY_DIR, "*")):
        if read_power_supply_attr(supply, "type") != "Battery":
            continue
        # skip batteries of peripherals like mice and keyboards
        if read_power_supply_attr(supply, "scope") == "Device":
            continue
        # skip empty battery bays
        if read_power_supply_attr(supply, "present") == "0":
            continue
        capacity = read_power_supply_attr(supply, "capacity")
        if capacity is None or not capacity.isdigit():
            return None
        levels.append(int(capacity))
    if not levels:
        return None
    return sum(levels) // len(levels)


def get_min_battery_level() -> int | None:
    """
    Return the battery charge in percent needed to upgrade on battery, or
    None if upgrades should only run on AC power.
    """
    value = apt_pkg.config.find("Unattended-Upgrade::MinBatteryLevel")
    if not value:
        if not apt_pkg.config.find("Unattended-Upgrade::OnlyOnACPower"):
            return DEFAULT_MIN_BATTERY_LEVEL
        if apt_pkg.config.find_b("Unattended-Upgrade::OnlyOnACPower", True):
            return None
        return 0
    if apt_pkg.config.find("Unattended-Upgrade::OnlyOnACPower"):
        log_once(_("Both MinBatteryLevel and OnlyOnACPower are set, "
                   "ignoring OnlyOnACPower"), logging.WARNING)
    if value == "ac-only":
        return None
    try:
        if 0 <= int(value) <= 100:
            return int(value)
    except ValueError:
        pass
    log_once(_("Invalid MinBatteryLevel \"%s\", upgrading only on AC power")
             % value, logging.WARNING)
    return None


def battery_charged_enough(min_level: int | None) -> bool:
    """
    Return True if the batteries are charged at least min_level percent.
    None means only on AC power, so never.
    """
    if min_level is None:
        return False
    level = get_battery_level()
    if level is None:
        log_once(_("Battery charge level could not be read"),
                 logging.WARNING)
        return False
    if level < min_level:
        logging.info(_("Battery charge is %d%%, below %d%%") % (
            level, min_level))
        return False
    log_once(_("On battery power, charge is %d%%, at least %d%%") % (
        level, min_level))
    return True


def should_stop() -> bool:
    """
    Return True if u-u needs to stop due to signal received or due to the
    system started to run on battery.
    """
    if SIGNAL_STOP_REQUEST:
        logging.warning("SIGNAL received, stopping")
        return True
    try:
        min_level = get_min_battery_level()
        if min_level != 0 \
           and subprocess.call("on_ac_power") == 1 \
           and not battery_charged_enough(min_level):
            logging.warning("System is on battery power, stopping")
            return True
    except (FileNotFoundError, PermissionError):
        log_once(
            _("Checking if system is running on battery is skipped. Please "
              "install powermgmt-base package to check power status and skip "
              "installing updates when the system is running on battery."))
    if apt_pkg.config.find_b(
            "Unattended-Upgrade::Skip-Updates-On-Metered-Connections", True):
        if is_metered_connection():
            logging.warning(_("System is on metered connection, stopping"))
            return True
    return False


def substitute(line: str) -> str:
    """ substitude known mappings and return a new string

    Currently supported: ${distro_id}, ${distro_codename} and
    ${distro_release}
    """
    mapping = {"distro_codename": get_distro_codename(),
               "distro_id": get_distro_id(),
               "distro_release": get_distro_release()}
    return string.Template(line).substitute(mapping)


def get_distro_codename() -> str:
    return DISTRO_CODENAME


def get_distro_id() -> str:
    return DISTRO_ID


def get_distro_release() -> str:
    return DISTRO_RELEASE


