#: ../unattended-upgrade:384
#, c-format
msgid "Allowed origins are: %s"
msgstr "Origini consentite sono: %s"

#: ../unattended-upgrade:389
#, c-format
msgid "Initial blacklist: %s"
msgstr "Blacklist iniziale: %s"

#: ../unattended-upgrade:395
#, c-format
msgid "Initial whitelist (%s): %s"
msgstr "Whitelist iniziale (%s): %s"

#: ../unattended-upgrade:434
msgid "The list of kept packages can't be calculated in dry-run mode."
msgstr ""
"In modalità di simulazione non è possibile calcolare l'elenco dei pacchetti "
"mantenuti alla versione attuale."

#: ../unattended-upgrade:456
#, c-format
msgid "Package %s is marked to be held back."
msgstr "Il pacchetto %s è contrassegnato come bloccato."

#: ../unattended-upgrade:458
#, c-format
msgid "Package %s is blacklisted."
msgstr "Il pacchetto %s è nella blacklist."

#: ../unattended-upgrade:462
#, c-format
msgid "Package %s is not on the strict whitelist."
msgstr "Il pacchetto %s non è nella whitelist stretta."

#: ../unattended-upgrade:465
#, c-format
msgid ""
"Package %s is not whitelisted and it is not a dependency of a whitelisted "
"package."
msgstr ""
"Il pacchetto %s non è nella whitelist e non è una dipendenza di un pacchetto "
"nella whitelist."

#: ../unattended-upgrade:469
#, c-format
msgid "Package %s's origin is not trusted."
msgstr "L'origine del pacchetto %s non è affidabile."

#: ../unattended-upgrade:470
#, c-format
msgid ""
"Package %s is kept back because a related package is kept back or due to "
"local apt_preferences(5)."
msgstr ""
"Il pacchetto %s è mantenuto alla versione attuale a causa di un pacchetto "
"correlato non aggiornato o delle impostazioni locali di apt_preferences(5)."

#: ../unattended-upgrade:587 ../unattended-upgrade:1317
#: ../unattended-upgrade:2211
#, c-format
msgid "package %s upgradable but fails to be marked for upgrade (%s)"
msgstr ""
"il pacchetto %s è aggiornabile, ma non è possibile impostarlo per essere "
"aggiornato (%s)"

#: ../unattended-upgrade:686
#, c-format
msgid "Progress: %s %% (%s)"
msgstr "Avanzamento: %s %% (%s)"

#: ../unattended-upgrade:908
msgid ""
"Checking if connection is metered is skipped. Please install python3-gi "
"package to detect metered connections and skip downloading updates."
msgstr ""
"Controllo della connessione a consumo saltato. Installare il pacchetto "
"python3-gi per determinare se la connessione Internet è a consumo e per "
"saltare lo scaricamento degli aggiornamenti."

#: ../unattended-upgrade:926
#, c-format
msgid ""
"Checking if connection is metered is skipped because NetworkManager could "
"not be queried: %s"
msgstr ""
"Controllo della connessione a consumo saltato perché non è stato possibile "
"interrogare NetworkManager: %s"

#: ../unattended-upgrade:978
msgid "Both MinBatteryLevel and OnlyOnACPower are set, ignoring OnlyOnACPower"
msgstr ""
"Sono impostati sia MinBatteryLevel sia OnlyOnACPower, OnlyOnACPower viene "
"ignorato"

#: ../unattended-upgrade:987
#, c-format
msgid "Invalid MinBatteryLevel \"%s\", upgrading only on AC power"
msgstr ""
"Valore di MinBatteryLevel \"%s\" non valido, aggiornamento solo con "
"alimentazione da rete"

#: ../unattended-upgrade:1001
msgid "Battery charge level could not be read"
msgstr "Impossibile leggere il livello di carica della batteria"

#: ../unattended-upgrade:1005
#, c-format
msgid "Battery charge is %d%%, below %d%%"
msgstr "Carica della batteria al %d%%, inferiore al %d%%"

#: ../unattended-upgrade:1008
#, c-format
msgid "On battery power, charge is %d%%, at least %d%%"
msgstr "Alimentazione da batteria, carica al %d%%, non inferiore al %d%%"

#: ../unattended-upgrade:1030
msgid ""
"Checking if system is running on battery is skipped. Please install "
"powermgmt-base package to check power status and skip installing updates "
"when the system is running on battery."
msgstr ""
"Controllo dell'alimentazione da batteria saltato. Installare il pacchetto "
"powermgmt-base per controllare lo stato dell'alimentazione del sistema e per "
"saltare l'installazione degli aggiornamenti se il sistema è alimentato dalla "
"batteria."

#: ../unattended-upgrade:1036
msgid "System is on metered connection, stopping"
msgstr "Il sistema utilizza una connessione a consumo, fermato"

#: ../unattended-upgrade:1126 ../unattended-upgrade:1142
#, c-format
msgid "Unable to parse %s."
msgstr "Impossibile analizzare %s."

#: ../unattended-upgrade:1225 ../unattended-upgrade:1388
#: ../unattended-upgrade:2989 ../unattended-upgrade-shutdown:110
msgid "All upgrades installed"
msgstr "Installati tutti gli aggiornamenti"

#: ../unattended-upgrade:1227 ../unattended-upgrade:1376
msgid "Installing the upgrades failed!"
msgstr "Installazione degli aggiornamenti non riuscita."

#: ../unattended-upgrade:1228 ../unattended-upgrade:1377
#: ../unattended-upgrade:1669 ../unattended-upgrade:1671
#: ../unattended-upgrade:2735 ../unattended-upgrade:2737
#, c-format
msgid "error message: %s"
msgstr "messaggio di errore: %s"

#: ../unattended-upgrade:1229 ../unattended-upgrade:1378
#, c-format
msgid "dpkg returned a error! See %s for details"
msgstr ""
"dpkg è terminato con un errore. Per maggiori informazioni consultare %s"

#: ../unattended-upgrade:1262 ../unattended-upgrade:1264
#, c-format
msgid "Package %s has conffile prompt and needs to be upgraded manually"
msgstr ""
"Il pacchetto %s richiede una scelta su un file di configurazione e deve "
"essere aggiornato manualmente"

#: ../unattended-upgrade:1338 ../unattended-upgrade:1339
#: ../unattended-upgrade:2792 ../unattended-upgrade:2793
#: ../unattended-upgrade:2795
#, c-format
msgid "Fetching the archives failed: %s"
msgstr "Scaricamento degli archivi non riuscito: %s"

#: ../unattended-upgrade:1668 ../unattended-upgrade:1670
#: ../unattended-upgrade:2734 ../unattended-upgrade:2736
#: ../unattended-upgrade:2739
msgid "Apt returned an error, exiting"
msgstr "apt è terminato con un errore, uscita"

#: ../unattended-upgrade:1873
msgid ""
"No /usr/bin/mail or /usr/sbin/sendmail, can not send mail. You probably want "
"to install the mailx package."
msgstr ""
"/usr/bin/mail o /usr/sbin/sendmail non disponibili, impossibile inviare "
"l'email. Potrebbe essere necessario installare il pacchetto mailx."

#: ../unattended-upgrade:1896
msgid "[reboot required]"
msgstr "[richiesto riavvio]"

#: ../unattended-upgrade:1898
msgid "[package on hold]"
msgstr "[pacchetto bloccato]"

#: ../unattended-upgrade:1902
msgid ""
"{hold_flag}{reboot_flag} unattended-upgrades result for {machine}: {result}"
msgstr ""
"{hold_flag}{reboot_flag} risultato di unattended-upgrades per {machine}: "
"{result}"

#: ../unattended-upgrade:1906
#, c-format
msgid "Unattended upgrade result: %s"
msgstr "Risultato degli aggiornamenti automatici: %s"

#: ../unattended-upgrade:1910
msgid ""
"Warning: A reboot is required to complete this upgrade, or a previous one.\n"
"\n"
msgstr ""
"Attenzione: è necessario riavviare il sistema per completare questo "
"aggiornamento o uno precedente.\n"
"\n"

#: ../unattended-upgrade:1914
msgid "Packages that were upgraded:\n"
msgstr "Pacchetti che sono stati aggiornati:\n"

#: ../unattended-upgrade:1916
msgid "Packages that attempted to upgrade:\n"
msgstr "Pacchetti che si è tentato di aggiornare:\n"

#: ../unattended-upgrade:1920
msgid "Packages with upgradable origin but kept back:\n"
msgstr "Pacchetti aggiornabili, ma mantenuti alla versione attuale:\n"

#: ../unattended-upgrade:1927
msgid "Packages that were auto-removed:\n"
msgstr "Pacchetti rimossi automaticamente:\n"

#: ../unattended-upgrade:1931
msgid "Packages that were kept from being auto-removed:\n"
msgstr "Pacchetti mantenuti e non rimossi automaticamente:\n"

#: ../unattended-upgrade:1935
msgid "Package installation log:"
msgstr "Registro installazione pacchetto:"

#: ../unattended-upgrade:1938
msgid "Unattended-upgrades log:\n"
msgstr "Registro di unattended-upgrades:\n"

#: ../unattended-upgrade:1969
#, c-format
msgid "Writing dpkg log to %s"
msgstr "Scrittura registro di dpkg su %s"

#: ../unattended-upgrade:2158
#, c-format
msgid "Found %s, but not rebooting because non-system user %s is logged in."
msgid_plural ""
"Found %s, but not rebooting because non-system user %s are logged in."
msgstr[0] ""
"Trovato %s, ma non viene eseguito il riavvio perché l'utente non di sistema "
"%s è collegato."
msgstr[1] ""
"Trovato %s, ma non viene eseguito il riavvio perché gli utenti non di "
"sistema %s sono collegati."

#: ../unattended-upgrade:2171
#, c-format
msgid "Found %s, but not rebooting because %s is logged in."
msgid_plural "Found %s, but not rebooting because %s are logged in."
msgstr[0] ""
"Trovato %s, ma non viene eseguito il riavvio perché l'utente %s è collegato."
msgstr[1] ""
"Trovato %s, ma non viene eseguito il riavvio perché gli utenti %s sono "
"collegati."

#: ../unattended-upgrade:2234 ../unattended-upgrade:2261
msgid "SIGNAL received, stopping package check"
msgstr "Segnale ricevuto, interruzione del controllo dei pacchetti"

#: ../unattended-upgrade:2321
#, c-format
msgid ""
"Keeping the following auto-removable package(s) because they include %s "
"which is set to be kept unmodified: %s"
msgstr ""
"Vengono mantenuti i seguenti pacchetti rimovibili automaticamente perché "
"includono %s, che deve restare invariato: %s"

#: ../unattended-upgrade:2328
#, c-format
msgid ""
"Keeping auto-removable %s package(s) because it would also remove the "
"following packages which should be kept in this step: %s"
msgstr ""
"Viene mantenuto il pacchetto rimovibile automaticamente %s perché la sua "
"rimozione toglierebbe anche i seguenti pacchetti, da mantenere in questo "
"passo: %s"

#: ../unattended-upgrade:2334
#, c-format
msgid ""
"Keeping %s auto-removable package(s) because it would also remove the "
"following packages which should be kept in this step: %s"
msgstr ""
"Vengono mantenuti %s pacchetti rimovibili automaticamente perché la loro "
"rimozione toglierebbe anche i seguenti pacchetti, da mantenere in questo "
"passo: %s"

#: ../unattended-upgrade:2344
#, c-format
msgid ""
"Keeping the following auto-removable package(s) because they include %s "
"which package is related to the running kernel: %s"
msgstr ""
"Vengono mantenuti i seguenti pacchetti rimovibili automaticamente perché "
"includono %s, un pacchetto legato al kernel in esecuzione: %s"

#: ../unattended-upgrade:2427
#, c-format
msgid "Packages that were successfully auto-removed: %s"
msgstr "Pacchetti rimossi automaticamente con successo: %s"

#: ../unattended-upgrade:2429
#, c-format
msgid "Packages that were kept from being auto-removed: %s"
msgstr "Pacchetti mantenuti e non rimossi automaticamente: %s"

#: ../unattended-upgrade:2433
msgid "Auto-removing the packages failed!"
msgstr "Rimozione automatica dei pacchetti non riuscita"

#: ../unattended-upgrade:2434
#, c-format
msgid "Error message: %s"
msgstr "Messaggio di errore: %s"

#: ../unattended-upgrade:2435
#, c-format
msgid "dpkg returned an error! See %s for details"
msgstr ""
"dpkg è terminato con un errore. Per maggiori informazioni consultare %s"

#: ../unattended-upgrade:2497
#, c-format
msgid "Could not read %s: %s"
msgstr "Impossibile leggere %s: %s"

#: ../unattended-upgrade:2520
#, c-format
msgid "Could not save the list of kept back packages already mailed to %s: %s"
msgstr ""
"Impossibile salvare in %s l'elenco dei pacchetti mantenuti alla versione "
"attuale già segnalati via email: %s"

#: ../unattended-upgrade:2534
#, c-format
msgid "Could not open %s for saving list of packages kept back."
msgstr ""
"Impossibile aprire %s per salvare l'elenco dei pacchetti mantenuti alla "
"versione attuale."

#: ../unattended-upgrade:2617
#, c-format
msgid "An error occurred: %s"
msgstr "Si è verificato un errore: %s"

#: ../unattended-upgrade:2621
msgid "An error occurred"
msgstr "Si è verificato un errore"

#: ../unattended-upgrade:2678 ../unattended-upgrade:2682
#, c-format
msgid "Not running on this development release before %s"
msgstr "Non viene eseguito su questo rilascio di sviluppo prima di %s"

#: ../unattended-upgrade:2693 ../unattended-upgrade:2694
msgid "Not running on the development release."
msgstr "Non viene eseguito sul rilascio di sviluppo."

#: ../unattended-upgrade:2697
msgid "Starting unattended upgrades script"
msgstr "Avvio dello script degli aggiornamenti automatici"

#: ../unattended-upgrade:2703
msgid "Lock could not be acquired (another package manager running?)"
msgstr ""
"Impossibile impostare il blocco (un altro gestore di pacchetti potrebbe "
"essere in esecuzione)"

#: ../unattended-upgrade:2705
msgid "Cache lock can not be acquired, exiting"
msgstr "Impossibile impostare il blocco sulla cache, uscita"

#: ../unattended-upgrade:2707
msgid "Lock could not be acquired"
msgstr "Impossibile impostare il blocco"

#: ../unattended-upgrade:2716 ../unattended-upgrade:2717
msgid "Unclean dpkg state detected, trying to correct"
msgstr "Rilevato uno stato di dpkg non pulito, tentativo di correzione"

#: ../unattended-upgrade:2728
#, c-format
msgid ""
"dpkg --configure -a output:\n"
"%s"
msgstr ""
"output di \"dpkg --configure -a\":\n"
"%s"

#: ../unattended-upgrade:2742 ../unattended-upgrade:2743
#: ../unattended-upgrade:2745 ../unattended-upgrade:2934
#: ../unattended-upgrade:2935 ../unattended-upgrade:2937
msgid "Cache has broken packages, exiting"
msgstr "La cache contiene dei pacchetti danneggiati, uscita"

#: ../unattended-upgrade:2787
msgid "Upgrade was interrupted"
msgstr "L'aggiornamento è stato interrotto"

#: ../unattended-upgrade:2823
#, c-format
msgid "package %s not upgraded"
msgstr "pacchetto %s non aggiornato"

#: ../unattended-upgrade:2850
#, c-format
msgid "Removing unused kernel packages: %s"
msgstr "Rimozione di pacchetti kernel non utilizzati: %s"

#: ../unattended-upgrade:2868 ../unattended-upgrade:2873
msgid ""
"No packages found that can be upgraded unattended and no pending auto-"
"removals"
msgstr ""
"Nessun pacchetto che possa essere aggiornato automaticamente e nessuna "
"rimozione automatica in sospeso"

#: ../unattended-upgrade:2899
#, c-format
msgid "Packages that may be upgraded: %s"
msgstr "Pacchetti che potrebbero essere aggiornati: %s"

#: ../unattended-upgrade:2901
#, c-format
msgid "Packages that will be upgraded: %s"
msgstr "Pacchetti che verranno aggiornati: %s"

#: ../unattended-upgrade:2922
#, c-format
msgid "Packages that were upgraded: %s"
msgstr "Pacchetti che sono stati aggiornati: %s"

#: ../unattended-upgrade:3029
msgid "print debug messages"
msgstr "Stampa messaggi di debug"

#: ../unattended-upgrade:3032
msgid "make apt/libapt print verbose debug messages"
msgstr "Fa in modo che apt/libapt stampino messaggi di debug"

#: ../unattended-upgrade:3037
msgid "print info messages"
msgstr "Stampa messaggi informativi"

#: ../unattended-upgrade:3040
msgid "Simulation, download but do not install"
msgstr "Simulazione, scarica ma non installa"

#: ../unattended-upgrade:3043
msgid "Only download, do not even try to install."
msgstr "Scarica solamente, non installa nulla"

#: ../unattended-upgrade:3046
msgid ""
"Upgrade in minimal steps (and allow interrupting with SIGTERM) (default)"
msgstr ""
"Aggiorna a piccoli passi (e consente l'interruzione con SIGTERM) "
"(predefinito)"

#: ../unattended-upgrade:3051
msgid "Upgrade all packages together instead of in smaller sets"
msgstr "Aggiorna tutti i pacchetti insieme invece che in gruppi più piccoli"

#: ../unattended-upgrade:3060
msgid "You need to be root to run this application"
msgstr "È necessario essere root per eseguire questa applicazione"

#: ../unattended-upgrade-shutdown:85
msgid ""
"Unattended-upgrade in progress during shutdown, please don't turn off the "
"computer"
msgstr ""
"Esecuzione di unattended-upgrade durante lo spegnimento del computer. Non "
"spegnerlo manualmente."

#: ../unattended-upgrade-shutdown:113
msgid ""
"Unattended-upgrades stopped. There may be upgrades left to be installed in "
"the next run."
msgstr ""
"«unattended-upgrades» fermato: potrebbero essere presenti degli "
"aggiornamenti da installare alla prossima esecuzione."

#: ../unattended-upgrade-shutdown:204 ../unattended-upgrade-shutdown:260
msgid "Unable to monitor PrepareForShutdown() signal, polling instead."
msgstr ""
"Impossibile monitorare il segnale PrepareForShutdown(), si passa al polling."

#: ../unattended-upgrade-shutdown:207
msgid ""
"To enable monitoring the PrepareForShutdown() signal instead of polling "
"please install the python3-gi package"
msgstr ""
"Per monitorare il segnale PrepareForShutdown() invece di fare polling "
"installare il pacchetto python3-gi"

#: ../unattended-upgrade-shutdown:263
msgid "Maybe systemd-logind service is not running."
msgstr "Forse il servizio systemd-logind non è in esecuzione."

#: ../unattended-upgrade-shutdown:286
msgid "Apt returned an error thus shutdown mode is disabled"
msgstr ""
"apt ha restituito un errore, quindi la modalità di spegnimento è disattivata"

#: ../unattended-upgrade-shutdown:288 ../unattended-upgrade-shutdown:369
#, c-format
msgid "error message: '%s'"
msgstr "messaggio di errore: '%s'"

#: ../unattended-upgrade-shutdown:304
msgid "Running unattended-upgrades in shutdown mode"
msgstr "Esecuzione di unattended-upgrades in modalità di spegnimento"

#: ../unattended-upgrade-shutdown:325
#, c-format
msgid "Giving up on lockfile after %s minutes of delay"
msgstr "Rinuncia al file di blocco dopo %s minuti di attesa"

#: ../unattended-upgrade-shutdown:367
msgid "Apt returned an error when loading configuration, using default values"
msgstr ""
"apt ha restituito un errore nel caricare la configurazione, vengono usati i "
"valori predefiniti"
